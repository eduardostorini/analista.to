# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Node / assets
node_modules/
app/static/dist/
npm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# Data generated at runtime
generated-pages/*
!generated-pages/.gitkeep
sitemaps/*
!sitemaps/.gitkeep
logs/*
!logs/.gitkeep
backups/*
!backups/.gitkeep

# Postgres / Docker local volumes
docker/postgres/data/
docker/postgres/generated/postgresql.conf

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test / build artifacts
dist/
build/
*.log
celerybeat-schedule*

# Scripts de terceiros injetados em todo <head>/<body> (Google Analytics,
# GTM, etc.) — específicos de cada ambiente/cliente, nunca versionados.
code/head.txt
code/body.txt
