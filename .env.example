# =============================================================================
# Analista.to — variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores antes de subir o projeto.
# NUNCA versione o arquivo `.env` real.
# =============================================================================

# --- Aplicação -----------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-value
SITE_NAME=Analista.to
SITE_URL=http://localhost:18473
# Prefixo do painel administrativo (mantenha fora de rotas óbvias como /admin)
ADMIN_URL_PREFIX=/gestor-x7f2

# --- Portas (host) ---------------------------------------------------------
APP_HTTP_PORT=18473
POSTGRES_DEV_PORT=15439
REDIS_DEV_PORT=16389

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=analisa_postgres
POSTGRES_PORT=5432
POSTGRES_DB=analisa_to
POSTGRES_USER=analisa
POSTGRES_PASSWORD=change-me-strong-password
# Memória total (MB) reservada ao container do Postgres; usada para calcular
# shared_buffers / effective_cache_size / etc. Ver docs/postgres-profiles.md
POSTGRES_MEMORY_MB=1024
POSTGRES_MAX_CONNECTIONS=100
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=5
SQLALCHEMY_POOL_RECYCLE=1800

# --- Redis -------------------------------------------------------------------
REDIS_HOST=analisa_redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2
CACHE_REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/3
RATE_LIMIT_REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/4

# --- Hash de IP / User-Agent (rotação de salt) --------------------------------
# Lista separada por vírgula "id:salt". O primeiro item é o salt ATUAL usado
# para novos hashes; os demais permanecem só para comparações históricas.
IP_HASH_SALTS=1:change-me-salt-one
IP_HASH_CURRENT_SALT_ID=1

# --- CAPTCHA -------------------------------------------------------------------
# Valores possíveis: cap | math | none
# cap  = Cap (https://trycap.dev), self-hosted via os serviços analisa_cap/
#        analisa_cap_store deste mesmo compose — sem Google, sem telemetria.
# math = desafio "quanto é X + Y" gerado no servidor, sem dependências extras.
# none = desliga o CAPTCHA (uso interno/testes apenas).
CAPTCHA_PROVIDER=cap

# --- Cap (CAPTCHA self-hosted) --------------------------------------------------
# Senha do dashboard do Cap (http://localhost:${CAP_HTTP_PORT}), mínimo 32
# caracteres. Só usada pelo próprio serviço analisa_cap.
CAP_ADMIN_KEY=change-me-cap-admin-key-min-32-characters
# Porta publicada do Cap no host — precisa ser alcançável pelo NAVEGADOR do
# visitante (diferente de Postgres/Redis, não é só para o backend).
CAP_HTTP_PORT=3010
# URL pública que o widget no navegador usa. Em produção, troque para um
# domínio/HTTPS próprio (ex.: https://cap.analista.to).
CAP_PUBLIC_URL=http://localhost:3010
# URL interna (rede do Docker Compose) usada pelo backend para validar o
# token resolvido — não precisa ser pública.
CAP_INTERNAL_URL=http://analisa_cap:3000
# Gerados no dashboard do Cap (Settings → Keys) depois do primeiro
# `docker compose up -d`: crie uma "site key" e cole os dois valores abaixo.
CAP_SITE_KEY=
CAP_SECRET_KEY=

MATH_CHALLENGE_TTL_SECONDS=300
MATH_CHALLENGE_MAX_ATTEMPTS=5

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_DEFAULT_PER_MINUTE=10
RATE_LIMIT_NETWORK_TOOLS_PER_MINUTE=5
RATE_LIMIT_GLOBAL_PER_MINUTE=600

# --- SSRF / requisições externas ------------------------------------------------
OUTBOUND_USER_AGENT=AnalistaToBot/1.0 (+https://analista.to/sobre/bot)
OUTBOUND_CONNECT_TIMEOUT_SECONDS=5
OUTBOUND_READ_TIMEOUT_SECONDS=10
OUTBOUND_MAX_REDIRECTS=5
OUTBOUND_MAX_RESPONSE_BYTES=2097152
OUTBOUND_ALLOWED_PORTS=80,443

# --- Fontes de dados de ferramentas específicas -----------------------------------
# API pública e gratuita (sem chave) usada pela ferramenta de IP Lookup para
# geolocalização/ASN aproximados. Troque por outro provedor se preferir.
IP_GEOLOCATION_API_URL=http://ip-api.com/json/{ip}?fields=status,message,country,countryCode,regionName,city,lat,lon,isp,org,as,query

# --- Proxy reverso (opcional) -----------------------------------------------------
# Ative apenas se houver um proxy confiável na frente (você controla o
# cabeçalho X-Forwarded-For). Sem isso, o IP do cliente é lido diretamente
# da conexão TCP.
TRUST_PROXY_HEADERS=0

# --- Admin -----------------------------------------------------------------------
ADMIN_EMAIL=admin@analista.to
# Gerado com: python scripts/hash_admin_password.py
# IMPORTANTE: hashes Argon2 têm o formato $argon2id$v=19$m=...$salt$hash — o
# Docker Compose interpreta "$" como início de variável ao ler o .env (mesmo
# fora do docker-compose.yml) e apaga tudo que parecer "$algumacoisa" sem
# avisar. Troque CADA "$" por "$$" ao colar o hash aqui, ou o login vai
# falhar silenciosamente com hash corrompido. O script acima já imprime o
# valor pronto, com "$$" — copie exatamente o que ele mostrar.
ADMIN_PASSWORD_HASH=

# --- Páginas estáticas / SEO -----------------------------------------------------
GENERATED_PAGES_DIR=/data/generated-pages
SITEMAPS_DIR=/data/sitemaps
SITEMAP_MAX_URLS_PER_FILE=45000
GENERATED_PAGE_MAX_AGE_DAYS=30

# --- Observabilidade ---------------------------------------------------------------
METRICS_ENABLED=1
LOG_LEVEL=INFO

# --- Node / build de assets (apenas no build da imagem / dev) ----------------------
NODE_ENV=development
