{
  "name": "analisa-to-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Build de assets (Tailwind CSS + Alpine.js + JS modular) do Analista.to",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./app/static/src/css/main.css -o ./app/static/dist/main.css --minify",
    "build:js": "node scripts/build-js.mjs",
    "watch": "concurrently \"npm run watch:css\" \"npm run watch:js\"",
    "watch:css": "tailwindcss -i ./app/static/src/css/main.css -o ./app/static/dist/main.css --watch",
    "watch:js": "node scripts/build-js.mjs --watch"
  },
  "devDependencies": {
    "@alpinejs/collapse": "3.14.1",
    "@alpinejs/focus": "3.14.1",
    "@tailwindcss/typography": "0.5.15",
    "alpinejs": "3.14.1",
    "altcha": "latest",
    "autoprefixer": "10.4.20",
    "concurrently": "9.0.1",
    "esbuild": "0.24.0",
    "lucide": "0.446.0",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13"
  }
}
